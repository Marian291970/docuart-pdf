        let pageCount = 0;
        const correctPassword = 'mbab';
        
        function renderRegistros(items) {
            const lista = document.getElementById('registrosList');
            
            if (items.length === 0) {
                lista.innerHTML = '<div class="no-results">No se encontraron resultados</div>';
                updateResultsInfo(0);
                return;
            }
            
            lista.innerHTML = items.map(reg => `
                <div class="registro-card" onclick="openModal('${reg.id}')">
                    <h3>${reg.titulo}</h3>
                    <p class="author">${reg.autor}</p>
                    <p>${reg.lugar} · ${reg.editorial || 'S.l.'}</p>
                    <span class="year">${reg.anio}</span>
                </div>
            `).join('');
            
            updateResultsInfo(items.length);
        }
        
        function updateResultsInfo(count) {
            document.getElementById('resultsCount').textContent = `Registros encontrados: ${count}`;
            document.getElementById('totalCount').textContent = `Total: ${registrosData.length}`;
        }
        
        function populateFilters() {
            const years = [...new Set(registrosData.map(r => r.anio))].sort().reverse();
            const types = [...new Set(registrosData.map(r => r.tipo))];
            
            const yearFilter = document.getElementById('yearFilter');
            years.forEach(year => {
                const option = document.createElement('option');
                option.value = year;
                option.textContent = year;
                yearFilter.appendChild(option);
            });
            
            const typeFilter = document.getElementById('typeFilter');
            types.forEach(type => {
                const option = document.createElement('option');
                option.value = type;
                option.textContent = type;
                typeFilter.appendChild(option);
            });
        }
        
        async function openModal(id) {
            const reg = registrosData.find(r => r.id === id);
            if (!reg) return;
            
            currentPdfFile = reg.pdf;
            pdfDoc = null;
            currentPage = 1;
            pageCount = 0;
            
            document.getElementById('modalTitle').textContent = reg.titulo;
            
            document.getElementById('isbd').innerHTML = `
                <div class="field">
                    <div class="field-label">Descripción ISBD</div>
                    <div class="field-value">${reg.isbd}</div>
                </div>
                <div class="field">
                    <div class="field-label">Clasificación CDU</div>
                    <div class="field-value">${reg.cdu || 'No especificada'}</div>
                </div>
            `;
            
            document.getElementById('marc').innerHTML = `
                <div class="field">
                    <div class="field-label">Registro MARC21</div>
                    <div class="field-value marc-value">${reg.marc}</div>
                </div>
            `;
            
            document.getElementById('materias').innerHTML = `
                <div class="field">
                    <div class="field-label">Encabezamientos de Materia (Universidad de Sevilla)</div>
                    <ul class="materias-list">
                        ${reg.materias.map(m => `<li>${m}</li>`).join('')}
                    </ul>
                </div>
            `;
            
            document.getElementById('resumen').innerHTML = `
                <div class="field">
                    <div class="field-label">Resumen</div>
                    <div class="field-value">${reg.resumen}</div>
                </div>
                <div class="field" style="font-size: 0.85rem; color: #8b8477; margin-top: 2rem;">
                    <strong>Metadatos de catalogación:</strong><br>
                    Catalogador: ${reg.catalogador}<br>
                    Fecha: ${reg.fecha_catalogacion}<br>
                    OCR verificado: ${reg.ocr_verificado ? 'Sí' : 'No'}
                </div>
            `;
            
            document.getElementById('documento').innerHTML = `
                <div class="pdf-viewer-container">
                    <div class="pdf-toolbar">
                        <button onclick="previousPage()">← Anterior</button>
                        <input type="number" id="pageInput" min="1" value="1" onchange="goToPage()">
                        <span class="pdf-info"><span id="currentPage">0</span> / <span id="totalPages">0</span></span>
                        <button onclick="nextPage()">Siguiente →</button>
                        <button class="btn btn-primary" onclick="openPasswordModal()" style="margin-left: auto;">🔒 Descargar PDF</button>
                    </div>
                    <div class="pdf-canvas-container">
                        <canvas id="pdfCanvas"></canvas>
                    </div>
                </div>
            `;
            
            document.getElementById('detailModal').classList.add('active');
            
            setTimeout(() => loadPdf(reg.pdf), 100);
        }
        
        async function loadPdf(filename) {
            const pdfjsLib = window['pdfjs-dist/build/pdf'];
            pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
            
            try {
                pdfDoc = await pdfjsLib.getDocument(`pdfs/${filename}`).promise;
                pageCount = pdfDoc.numPages;
                document.getElementById('totalPages').textContent = pageCount;
                document.getElementById('pageInput').max = pageCount;
                renderPage(1);
            } catch (error) {
                const container = document.querySelector('.pdf-canvas-container');
                container.innerHTML = '⚠️ PDF no encontrado. Verifica que el archivo exista en la carpeta /pdfs/';
            }
        }
        
        async function renderPage(num) {
            if (!pdfDoc) return;
            
            const page = await pdfDoc.getPage(num);
            const scale = 1.5;
            const viewport = page.getViewport({ scale: scale });
            const canvas = document.getElementById('pdfCanvas');
            const context = canvas.getContext('2d');
            
            canvas.height = viewport.height;
            canvas.width = viewport.width;
            
            const renderContext = {
                canvasContext: context,
                viewport: viewport
            };
            
            await page.render(renderContext).promise;
            
            currentPage = num;
            document.getElementById('currentPage').textContent = num;
            document.getElementById('pageInput').value = num;
        }
        
        function nextPage() {
            if (currentPage < pageCount) {
                renderPage(currentPage + 1);
            }
        }
        
        function previousPage() {
            if (currentPage > 1) {
                renderPage(currentPage - 1);
            }
        }
        
        function goToPage() {
            const page = parseInt(document.getElementById('pageInput').value);
            if (page >= 1 && page <= pageCount) {
                renderPage(page);
            }
        }
        
        function closeModal() {
            document.getElementById('detailModal').classList.remove('active');
        }
        
        function switchTab(tabName, event) {
            document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            
            document.getElementById(tabName).classList.add('active');
            event.target.classList.add('active');
        }
        
        function openPasswordModal() {
            document.getElementById('passwordInput').value = '';
            document.getElementById('passwordModal').classList.add('active');
            document.getElementById('passwordInput').focus();
        }
        
        function closePasswordModal() {
            document.getElementById('passwordModal').classList.remove('active');
        }
        
        function downloadWithPassword() {
            const password = document.getElementById('passwordInput').value.toLowerCase();
            
            if (password !== correctPassword) {
                alert('❌ Contraseña incorrecta. Intenta de nuevo.');
                return;
            }
            
            const link = document.createElement('a');
            link.href = `pdfs/${currentPdfFile}`;
            link.download = currentPdfFile;
            link.click();
            
            closePasswordModal();
        }
        
        document.getElementById('searchInput').addEventListener('input', function(e) {
            const query = e.target.value.toLowerCase();
            const filtered = registrosData.filter(r => 
                r.titulo.toLowerCase().includes(query) ||
                r.autor.toLowerCase().includes(query) ||
                r.resumen.toLowerCase().includes(query) ||
                r.materias.some(m => m.toLowerCase().includes(query))
            );
            renderRegistros(filtered);
        });
        
        document.getElementById('yearFilter').addEventListener('change', applyFilters);
        document.getElementById('typeFilter').addEventListener('change', applyFilters);
        
        function applyFilters() {
            const year = document.getElementById('yearFilter').value;
            const type = document.getElementById('typeFilter').value;
            
            let filtered = registrosData;
            if (year) filtered = filtered.filter(r => r.anio === year);
            if (type) filtered = filtered.filter(r => r.tipo === type);
            
            renderRegistros(filtered);
        }
        
        function exportToJSON() {
            const dataStr = JSON.stringify(registrosData, null, 2);
            const dataBlob = new Blob([dataStr], { type: 'application/json' });
            const url = URL.createObjectURL(dataBlob);
            const link = document.createElement('a');
            link.href = url;
            link.download = `docuart-registros-${new Date().toISOString().split('T')[0]}.json`;
            link.click();
        }
        
        function exportToCSV() {
            if (registrosData.length === 0) {
                alert('No hay registros para exportar');
                return;
            }
            
            const headers = ['ID', 'Título', 'Autor', 'Año', 'Lugar', 'Editorial', 'Tipo', 'CDU'];
            const rows = registrosData.map(r => [
                r.id, r.titulo, r.autor, r.anio, r.lugar, r.editorial, r.tipo, r.cdu
            ]);
            
            let csv = headers.join(',') + '\n';
            rows.forEach(row => {
                csv += row.map(cell => `"${String(cell).replace(/"/g, '""')}"`).join(',') + '\n';
            });
            
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = `docuart-registros-${new Date().toISOString().split('T')[0]}.csv`;
            link.click();
        }
        
        document.getElementById('passwordInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') downloadWithPassword();
        });
        
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeModal();
                closePasswordModal();
            }
            if (e.key === 'ArrowRight' && pdfDoc) nextPage();
            if (e.key === 'ArrowLeft' && pdfDoc) previousPage();
        });
        
        // Inicializar
        renderRegistros(registrosData);
        populateFilters();
        updateResultsInfo(registrosData.length);
    </script>
